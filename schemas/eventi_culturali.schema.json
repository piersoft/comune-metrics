{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/italia/data/comune-metrics/schemas/eventi_culturali/v2.1",
  "title": "Paniere ComuneMetrics — eventi_culturali.csv",
  "description": "Schema di validazione del dataset 'Eventi culturali e sportivi' del paniere ComuneMetrics. Una riga per evento.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id_evento", "denominazione", "categoria",
      "data_inizio", "data_fine", "luogo_nome",
      "tipo_organizzazione", "gratuito"
    ],
    "properties": {
      "id_evento": {
        "type": "string",
        "minLength": 3,
        "maxLength": 100
      },
      "denominazione": {
        "type": "string",
        "minLength": 2,
        "maxLength": 300,
        "description": "Titolo evento"
      },
      "categoria": {
        "type": "string",
        "enum": [
          "MUSICA", "TEATRO", "CINEMA", "MOSTRA", "LETTERATURA",
          "SPORT", "FOOD", "RELIGIOSO", "CIVILE", "BAMBINI",
          "MERCATO", "ALTRO"
        ]
      },
      "data_inizio": {
        "type": "string",
        "format": "date"
      },
      "data_fine": {
        "type": "string",
        "format": "date"
      },
      "luogo_nome": {
        "type": "string",
        "minLength": 2,
        "maxLength": 200,
        "description": "Nome del luogo (piazza, edificio, quartiere)"
      },
      "lat": {
        "type": ["number", "null"],
        "minimum": 35.0,
        "maximum": 47.5
      },
      "lon": {
        "type": ["number", "null"],
        "minimum": 6.5,
        "maximum": 18.6
      },
      "tipo_organizzazione": {
        "type": "string",
        "enum": ["ORGANIZZATO", "PATROCINATO", "COFINANZIATO"],
        "description": "Ruolo del Comune nell'evento"
      },
      "contributo_comunale": {
        "type": ["number", "null"],
        "minimum": 0,
        "description": "Contributo erogato dal Comune (€)"
      },
      "partecipanti_stimati": {
        "type": ["integer", "null"],
        "minimum": 0,
        "description": "Stima partecipanti"
      },
      "gratuito": {
        "type": "boolean",
        "description": "Ingresso gratuito"
      }
    }
  }
}
