{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/italia/data/comune-metrics/schemas/bilancio/v2.1",
  "title": "Paniere ComuneMetrics — bilancio.csv",
  "description": "Schema di validazione del dataset 'Bilancio per missione' del paniere ComuneMetrics. Conforme al DM 18/04/2012 (armonizzazione bilanci EELL). Una riga per anno × tipo_documento × missione × programma × titolo.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "anno", "tipo_documento", "missione_codice", "missione_nome",
      "programma_codice", "programma_nome", "titolo",
      "stanziamento_iniziale", "stanziamento_assestato",
      "impegnato", "pagato", "popolazione_riferimento"
    ],
    "properties": {
      "anno": {
        "type": "integer",
        "minimum": 2000,
        "maximum": 2050,
        "description": "Anno di esercizio"
      },
      "tipo_documento": {
        "type": "string",
        "enum": ["PREVISIONE", "RENDICONTO"],
        "description": "Tipologia del documento di bilancio"
      },
      "missione_codice": {
        "type": "string",
        "pattern": "^(0[1-9]|1[0-9]|20|99)$",
        "description": "Codice missione DM 18/04/2012 (01-20, 99 per servizi per conto terzi)"
      },
      "missione_nome": {
        "type": "string",
        "minLength": 3,
        "maxLength": 200,
        "description": "Denominazione missione"
      },
      "programma_codice": {
        "type": "string",
        "pattern": "^[0-9]{2}$",
        "description": "Codice programma (2 cifre)"
      },
      "programma_nome": {
        "type": "string",
        "minLength": 3,
        "maxLength": 200,
        "description": "Denominazione programma"
      },
      "titolo": {
        "type": "string",
        "enum": ["1", "2", "3"],
        "description": "1=Spese correnti, 2=Conto capitale, 3=Incremento attività finanziarie"
      },
      "stanziamento_iniziale": {
        "type": "number",
        "minimum": 0,
        "description": "Stanziamento di bilancio iniziale (€)"
      },
      "stanziamento_assestato": {
        "type": "number",
        "minimum": 0,
        "description": "Stanziamento dopo variazioni (€)"
      },
      "impegnato": {
        "type": "number",
        "minimum": 0,
        "description": "Importo impegnato (€)"
      },
      "pagato": {
        "type": "number",
        "minimum": 0,
        "description": "Importo pagato in c/competenza (€)"
      },
      "popolazione_riferimento": {
        "type": "integer",
        "minimum": 1,
        "description": "Popolazione di riferimento per calcolo pro-capite"
      }
    }
  }
}
