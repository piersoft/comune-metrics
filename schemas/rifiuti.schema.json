{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/italia/data/comune-metrics/schemas/rifiuti/v2.1",
  "title": "Paniere ComuneMetrics — rifiuti.csv",
  "description": "Schema di validazione del dataset 'Raccolta rifiuti' del paniere ComuneMetrics. Conforme al D.Lgs. 152/2006 e tassonomia ISPRA-Catasto Rifiuti. Una riga per anno × mese × frazione × area.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["anno", "mese", "area_sub_comunale", "frazione", "quantita_kg", "popolazione_servita"],
    "properties": {
      "anno": {
        "type": "integer",
        "minimum": 2000,
        "maximum": 2050
      },
      "mese": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12,
        "description": "Mese (1-12)"
      },
      "area_sub_comunale": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "Quartiere/zona o 'TOTALE_COMUNE'"
      },
      "frazione": {
        "type": "string",
        "enum": [
          "INDIFFERENZIATO", "ORGANICO", "CARTA_CARTONE", "VETRO",
          "PLASTICA", "METALLI", "MULTIMATERIALE", "INGOMBRANTI",
          "RAEE", "VERDE_LIGNEO", "OLI_VEGETALI", "TESSILI",
          "FARMACI", "PILE", "ALTRO"
        ],
        "description": "Frazione merceologica"
      },
      "quantita_kg": {
        "type": "number",
        "minimum": 0,
        "description": "Quantità raccolta in kg"
      },
      "costo_totale": {
        "type": ["number", "null"],
        "minimum": 0,
        "description": "Costo gestione frazione (€)"
      },
      "popolazione_servita": {
        "type": "integer",
        "minimum": 1,
        "description": "Popolazione di riferimento per il calcolo pro-capite"
      }
    }
  }
}
