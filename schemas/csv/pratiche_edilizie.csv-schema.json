{
  "$schema": "https://piersoft.github.io/comune-metrics/schemas/csv/_meta.schema.json",
  "dataset": "pratiche_edilizie",
  "title": "Pratiche edilizie (CILA, SCIA, permessi)",
  "description": "Una riga per pratica edilizia presentata al SUE.",
  "version": "1.0",
  "encoding": "UTF-8",
  "delimiter_allowed": [",", ";"],
  "decimal_separator": ".",
  "required_columns": [
    {
      "name": "data",
      "datatype": "date",
      "format": "YYYY-MM-DD",
      "description": "Data di presentazione/protocollo della pratica"
    }
  ],
  "optional_columns": [
    {
      "name": "tipo",
      "datatype": "string",
      "max_length": 200,
      "description": "Tipo di pratica (es. 'CILA', 'SCIA', 'Permesso di costruire')"
    },
    {
      "name": "esito",
      "datatype": "string",
      "max_length": 100,
      "description": "Esito (es. 'Favorevole', 'Sfavorevole', 'Acquisita', 'In istruttoria')"
    },
    {
      "name": "data_chiusura",
      "datatype": "date",
      "format": "YYYY-MM-DD",
      "description": "Data di chiusura/disposto"
    },
    {
      "name": "indirizzo",
      "datatype": "string",
      "max_length": 500,
      "description": "Indirizzo dell'intervento"
    },
    {
      "name": "quartiere",
      "datatype": "string",
      "max_length": 200,
      "description": "Quartiere"
    }
  ],
  "example": "data,tipo,esito,data_chiusura,indirizzo,quartiere\n2024-03-15,CILA,Favorevole,2024-04-02,\"Via Marconi 12\",\"Centro storico\"\n2024-03-16,SCIA,Acquisita,2024-03-16,\"Viale Repubblica 45\",\"Navile\"\n2024-03-18,\"Permesso di costruire\",\"In istruttoria\",,\"Strada Maggiore 89\",\"Santo Stefano\"\n",
  "notes": [
    "Le date devono essere in formato ISO YYYY-MM-DD.",
    "data_chiusura vuota = pratica ancora aperta.",
    "Il tasso di chiusura viene calcolato come (pratiche con data_chiusura) / (totale pratiche)."
  ]
}
