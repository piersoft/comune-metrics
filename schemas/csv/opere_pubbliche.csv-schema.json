{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piersoft.github.io/comune-metrics/schemas/csv/opere_pubbliche.csv-schema.json",
  "title": "Paniere CSV — opere_pubbliche.csv",
  "description": "Una riga per opera/cantiere con identificativo, importo, geolocalizzazione, fonte di finanziamento.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["nome"],
    "properties": {
      "nome": { "type": "string", "minLength": 1, "maxLength": 500 },
      "anno": { "type": ["integer", "null"], "minimum": 1900, "maximum": 2050 },
      "stato": { "type": ["string", "null"], "maxLength": 100, "description": "Es. 'in corso', 'concluso', 'progettazione', 'gara'" },
      "importo_euro": { "type": ["number", "null"], "minimum": 0 },
      "cup": { "type": ["string", "null"], "pattern": "^[A-Z][0-9]{2}[A-Z][0-9]{7}[0-9]{4}$", "description": "Codice Unico di Progetto (15 caratteri)" },
      "fonte_finanziamento": { "type": ["string", "null"], "maxLength": 200, "description": "Es. 'PNRR', 'Comunale', 'Statale', 'Europeo'" },
      "lat": { "type": ["number", "null"], "minimum": 35, "maximum": 48, "description": "Latitudine (Italia: 35-48)" },
      "lon": { "type": ["number", "null"], "minimum": 6, "maximum": 19, "description": "Longitudine (Italia: 6-19)" },
      "tipo": { "type": ["string", "null"], "maxLength": 200, "description": "Es. 'nuova realizzazione', 'manutenzione ordinaria', 'manutenzione straordinaria'" },
      "rup": { "type": ["string", "null"], "maxLength": 200, "description": "Responsabile Unico del Procedimento" }
    }
  }
}
