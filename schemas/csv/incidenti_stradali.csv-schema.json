{
  "$schema": "https://piersoft.github.io/comune-metrics/schemas/csv/_meta.schema.json",
  "dataset": "incidenti_stradali",
  "title": "Incidenti stradali",
  "description": "Una riga per incidente con data, geo, vittime.",
  "version": "2.0",
  "encoding": "UTF-8",
  "delimiter_allowed": [
    ",",
    ";"
  ],
  "decimal_separator": ".",
  "rename_aliases": {
    "morti": "decessi",
    "zona": "localita"
  },
  "required_columns": [],
  "optional_columns": [
    {
      "name": "lat",
      "datatype": "number",
      "constraints": {
        "min": -90,
        "max": 90
      },
      "description": "Latitudine del punto dell'incidente",
      "rdf_predicate": "geo:lat"
    },
    {
      "name": "lon",
      "datatype": "number",
      "constraints": {
        "min": -180,
        "max": 180
      },
      "description": "Longitudine",
      "rdf_predicate": "geo:long"
    },
    {
      "name": "decessi",
      "datatype": "integer",
      "constraints": {
        "min": 0
      },
      "description": "Numero di morti nell'incidente (ex 'morti')",
      "rdf_predicate": "sdmx-measure:obsValue"
    },
    {
      "name": "feriti",
      "datatype": "integer",
      "constraints": {
        "min": 0
      },
      "description": "Numero di feriti (semantica unica → arricchimento via LLM)"
    },
    {
      "name": "localita",
      "datatype": "string",
      "max_length": 200,
      "description": "Zona, quartiere o nome della strada (ex 'zona')",
      "rdf_predicate": "clv:hasSpatialCoverage"
    },
    {
      "name": "tipo",
      "datatype": "string",
      "max_length": 200,
      "description": "Tipologia (es. 'tamponamento', 'investimento pedone', 'scontro frontale')",
      "rdf_predicate": "dct:type@it"
    },
    {
      "name": "veicoli_coinvolti",
      "datatype": "integer",
      "constraints": {
        "min": 0
      },
      "description": "Numero di veicoli coinvolti"
    },
    {
      "name": "numero_incidenti",
      "datatype": "integer",
      "description": "Conteggio (sempre 1 per riga di sinistro)"
    },
    {
      "name": "mese",
      "datatype": "string",
      "description": "Mese (per QB)",
      "max_length": 10
    },
    {
      "name": "data",
      "datatype": "date",
      "format": "YYYY-MM-DD",
      "description": "Data dell'incidente",
      "rdf_predicate": "ti:startTime^^xsd:date"
    },
    {
      "name": "ora",
      "datatype": "string",
      "description": "Colonna formato demo Worker incidenti_stradali"
    },
    {
      "name": "comune",
      "datatype": "string",
      "description": "Colonna formato demo Worker incidenti_stradali"
    },
    {
      "name": "via",
      "datatype": "string",
      "description": "Colonna formato demo Worker incidenti_stradali"
    },
    {
      "name": "tipo_incidente",
      "datatype": "string",
      "description": "Colonna formato demo Worker incidenti_stradali"
    },
    {
      "name": "morti",
      "datatype": "string",
      "description": "Colonna formato demo Worker incidenti_stradali"
    },
    {
      "name": "condizioni_meteo",
      "datatype": "string",
      "description": "Colonna formato demo Worker incidenti_stradali"
    }
  ],
  "example": "data,lat,lon,decessi,feriti,localita,tipo\n2024-01-15,40.37924,18.15166,0,2,\"Viale Marche\",\"tamponamento\"\n2024-01-22,40.36422,18.14054,1,0,\"Via Lecce-San Cataldo\",\"investimento pedone\"\n2024-02-03,40.33956,18.17699,0,3,\"Tangenziale Est\",\"scontro frontale\"\n",
  "notes": [
    "Coordinate gradi decimali, separatore punto. Range plausibile: lat -90/+90, lon -180/+180.",
    "Se hai feriti=0 e decessi=0, lascia 0 (non vuoto) per chiarezza.",
    "v2.0: rinomina 'morti'→'decessi' e 'zona'→'localita' per allineamento al tool CSV-to-RDF (DET_COL_RULES). 'feriti' rimane: semantica unica, va a LLM."
  ],
  "additional_columns_allowed": true
}