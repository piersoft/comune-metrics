{
  "$schema": "https://piersoft.github.io/comune-metrics/schemas/csv/_meta.schema.json",
  "dataset": "istruzione",
  "title": "Istruzione e asili nido",
  "description": "Una riga per scuola/struttura educativa con iscritti, geo, tipologia.",
  "version": "1.0",
  "encoding": "UTF-8",
  "delimiter_allowed": [",", ";"],
  "decimal_separator": ".",
  "required_columns": [
    {
      "name": "struttura",
      "datatype": "string",
      "max_length": 300,
      "description": "Nome della scuola o struttura educativa"
    }
  ],
  "optional_columns": [
    {
      "name": "anno_scolastico",
      "datatype": "string",
      "max_length": 20,
      "description": "Anno scolastico (es. '2024-2025' o '2024')"
    },
    {
      "name": "tipo_struttura",
      "datatype": "string",
      "enum": ["Asilo nido", "Infanzia", "Primaria", "Secondaria I grado", "Secondaria II grado", "Liceo", "Tecnico", "Professionale", "CPA", "Altro"],
      "description": "Tipologia di struttura educativa"
    },
    {
      "name": "iscritti",
      "datatype": "integer",
      "constraints": { "min": 0 },
      "description": "Numero di iscritti / alunni"
    },
    {
      "name": "lat",
      "datatype": "number",
      "constraints": { "min": -90, "max": 90 },
      "description": "Latitudine"
    },
    {
      "name": "lon",
      "datatype": "number",
      "constraints": { "min": -180, "max": 180 },
      "description": "Longitudine"
    },
    {
      "name": "indirizzo",
      "datatype": "string",
      "max_length": 500,
      "description": "Indirizzo della struttura"
    },
    {
      "name": "quartiere",
      "datatype": "string",
      "max_length": 200,
      "description": "Quartiere"
    },
    {
      "name": "gestione",
      "datatype": "string",
      "enum": ["Statale", "Comunale", "Paritaria", "Privata"],
      "description": "Tipologia di gestione"
    },
    {
      "name": "mensa",
      "datatype": "string",
      "enum": ["Sì", "No"],
      "description": "Presenza servizio mensa"
    }
  ],
  "example": "struttura,anno_scolastico,tipo_struttura,iscritti,lat,lon,indirizzo,gestione,mensa\n\"Liceo Scientifico Banzi\",2024-2025,\"Liceo\",1771,40.3528,18.1718,\"Via Giuseppe Cesare Abba 5\",\"Statale\",\"No\"\n\"Scuola Infanzia Cesare Battisti\",2024-2025,\"Infanzia\",160,40.3538,18.1750,\"Via Salvatore Trinchese\",\"Statale\",\"Sì\"\n",
  "notes": [
    "Il dataset può coprire dagli asili nido alle scuole superiori — usa il campo tipo_struttura per disambiguare.",
    "Se hai solo asili nido (caso più comune), tipo_struttura sarà sempre 'Asilo nido'."
  ]
}
