{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piersoft.github.io/comune-metrics/schemas/csv/patrimonio.csv-schema.json",
  "title": "Paniere CSV — patrimonio.csv (v2.0)",
  "description": "Una riga per immobile di proprietà comunale.",
  "version": "2.0",
  "rename_aliases": {
    "valore_euro": "rendita",
    "vincolo_culturale": "qualita",
    "uso": "consistenza"
  },
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": true,
    "required": [],
    "properties": {
      "denominazione": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "rdf_predicate": "rdfs:label@it"
      },
      "tipo": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 200,
        "description": "Es. 'Scuola', 'Ufficio', 'Magazzino', 'Cimitero'",
        "rdf_predicate": "dct:type@it"
      },
      "indirizzo": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 500,
        "description": "Indirizzo (aggregato in clv:Address dal tool)"
      },
      "lat": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 35,
        "maximum": 48,
        "rdf_predicate": "geo:lat"
      },
      "lon": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 6,
        "maximum": 19,
        "rdf_predicate": "geo:long"
      },
      "autore": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 300,
        "description": "Autore del bene"
      },
      "datazione": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 100,
        "description": "Datazione del bene (es. 'sec. XX')"
      },
      "valore": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0,
        "description": "Valore patrimoniale o rendita catastale in euro",
        "rdf_predicate": "sdmx-measure:obsValue"
      },
      "tipo_bene": {
        "type": [
          "string",
          "null",
          "boolean"
        ],
        "maxLength": 100,
        "description": "Tipo di vincolo o qualità del bene (es. 'monumentale')",
        "rdf_predicate": "dct:type@it"
      },
      "descrizione": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 200,
        "description": "Destinazione e descrizione del bene",
        "rdf_predicate": "dct:description"
      },
      "id": {
        "type": [
          "string",
          "integer",
          "null"
        ]
      },
      "codice_bene": {
        "type": [
          "string",
          "null"
        ]
      },
      "denominazione_bene": {
        "type": [
          "string",
          "null"
        ]
      },
      "tutela": {
        "type": [
          "string",
          "null"
        ]
      },
      "vincolo": {
        "type": [
          "string",
          "null"
        ]
      },
      "epoca": {
        "type": [
          "string",
          "null"
        ]
      },
      "materiale": {
        "type": [
          "string",
          "null"
        ]
      },
      "stato_conservazione": {
        "type": [
          "string",
          "null"
        ]
      },
      "ente_tutela": {
        "type": [
          "string",
          "null"
        ]
      },
      "comune": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "notes": [
    "v2.0: rinomina 'valore_euro'→'rendita', 'vincolo_culturale'→'qualita', 'uso'→'consistenza' per allineamento al tool CSV-to-RDF (DET_COL_RULES, semantica catastale)."
  ]
}