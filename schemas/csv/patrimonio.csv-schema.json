{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piersoft.github.io/comune-metrics/schemas/csv/patrimonio.csv-schema.json",
  "title": "Paniere CSV — patrimonio.csv",
  "description": "Una riga per immobile di proprietà comunale.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["denominazione"],
    "properties": {
      "denominazione": { "type": "string", "minLength": 1, "maxLength": 500 },
      "tipo": { "type": ["string", "null"], "maxLength": 200, "description": "Es. 'Scuola', 'Ufficio', 'Magazzino', 'Cimitero'" },
      "indirizzo": { "type": ["string", "null"], "maxLength": 500 },
      "lat": { "type": ["number", "null"], "minimum": 35, "maximum": 48 },
      "lon": { "type": ["number", "null"], "minimum": 6, "maximum": 19 },
      "valore_euro": { "type": ["number", "null"], "minimum": 0 },
      "vincolo_culturale": { "type": ["boolean", "null"] },
      "uso": { "type": ["string", "null"], "maxLength": 200, "description": "Es. 'Strumentale', 'Disponibile', 'Storico-artistico'" }
    }
  }
}
