{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/italia/data/comune-metrics/schemas/incidenti_stradali/v2.1",
  "title": "Paniere ComuneMetrics — incidenti_stradali.csv",
  "description": "Schema di validazione del dataset 'Incidenti stradali' del paniere ComuneMetrics. Conforme al modulo ISTAT CTT/INC. Una riga per incidente.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id_incidente", "data", "ora", "lat", "lon", "via",
      "tipo_strada", "natura", "veicoli_coinvolti", "feriti", "deceduti"
    ],
    "properties": {
      "id_incidente": {
        "type": "string",
        "minLength": 3,
        "maxLength": 100,
        "description": "Identificativo univoco anonimizzato (no dati personali)"
      },
      "data": {
        "type": "string",
        "format": "date",
        "description": "Data incidente (ISO 8601)"
      },
      "ora": {
        "type": "string",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
        "description": "Ora HH:MM (formato 24h)"
      },
      "lat": {
        "type": "number",
        "minimum": 35.0,
        "maximum": 47.5,
        "description": "Latitudine WGS84 (gradi decimali, bounding box Italia)"
      },
      "lon": {
        "type": "number",
        "minimum": 6.5,
        "maximum": 18.6,
        "description": "Longitudine WGS84 (gradi decimali, bounding box Italia)"
      },
      "via": {
        "type": "string",
        "minLength": 2,
        "maxLength": 200,
        "description": "Strada o toponimo"
      },
      "civico": {
        "type": ["string", "null"],
        "maxLength": 50,
        "description": "Numero civico o intersezione"
      },
      "tipo_strada": {
        "type": "string",
        "enum": ["URBANA_PRINCIPALE", "URBANA_SECONDARIA", "EXTRAURBANA", "AUTOSTRADA"],
        "description": "Classificazione strada"
      },
      "natura": {
        "type": "string",
        "enum": [
          "SCONTRO_FRONTALE", "SCONTRO_LATERALE", "TAMPONAMENTO",
          "INVESTIMENTO_PEDONE", "URTO_OSTACOLO", "FUORIUSCITA", "ALTRO"
        ],
        "description": "Natura dell'incidente"
      },
      "veicoli_coinvolti": {
        "type": "integer",
        "minimum": 0,
        "maximum": 50,
        "description": "Numero veicoli coinvolti"
      },
      "feriti": {
        "type": "integer",
        "minimum": 0,
        "description": "Numero feriti"
      },
      "feriti_gravi": {
        "type": ["integer", "null"],
        "minimum": 0,
        "description": "Feriti con prognosi >40gg"
      },
      "deceduti": {
        "type": "integer",
        "minimum": 0,
        "description": "Numero deceduti (entro 30gg dall'evento)"
      },
      "coinvolti_pedoni": {
        "type": ["integer", "null"],
        "minimum": 0,
        "description": "Pedoni coinvolti"
      },
      "coinvolti_ciclisti": {
        "type": ["integer", "null"],
        "minimum": 0,
        "description": "Ciclisti coinvolti"
      },
      "condizioni_meteo": {
        "type": ["string", "null"],
        "enum": ["SERENO", "PIOGGIA", "NEBBIA", "NEVE", "ALTRO", null],
        "description": "Condizioni meteo al momento dell'evento"
      }
    }
  }
}
